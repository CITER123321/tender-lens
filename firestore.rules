rules_version = '2';

// Each signed-in (anonymous) user can only read and write their own watchlist.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/tenders/{tenderId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'id', 'url', 'source', 'title', 'buyer', 'reference', 'deadline', 'deposit',
          'summary', 'checklist', 'engine', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.url is string && request.resource.data.url.size() < 2000
        && request.resource.data.title is string && request.resource.data.title.size() < 1000
        && request.resource.data.summary is string && request.resource.data.summary.size() < 5000
        && request.resource.data.checklist is list && request.resource.data.checklist.size() <= 60;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
