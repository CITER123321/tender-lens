{
  "manifest_version": 3,
  "name": "Tender Lens",
  "short_name": "Tender Lens",
  "version": "0.1.0",
  "description": "Turns Polish and EU tender notices into a bid checklist: deadline, bid security, conditions, criteria, documents. On-device AI first.",
  "minimum_chrome_version": "139",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Tender Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "https://ezamowienia.gov.pl/*",
    "https://bazakonkurencyjnosci.funduszeeuropejskie.gov.pl/*",
    "https://ted.europa.eu/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
