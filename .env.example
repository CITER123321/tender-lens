# Copy this file to .env and paste the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration (Config).
# The web config is not a secret, but keep .env out of git anyway (it is in .gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (development builds only).
# 1. Run `npm run debug-token` to generate a UUID (or use any UUID v4).
# 2. Register it in Firebase console > App Check > Apps > your web app > Manage debug tokens.
# 3. Paste it here. Never commit it and never publish a build that contains it.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: cloud model used when the request goes to the cloud (Remote Config key `cloud_model` overrides it).
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# Set to true to run without Firebase at all (deterministic parser + fake AI). `npm run build:mock` does this for you.
VITE_AI_MOCK=false
